-- 1. Πίνακας COUNTRY (Σύμφωνα με το σχήμα: COUNTRY ID, NAME)CREATE TABLE COUNTRY (    COUNTRY_ID NUMBER PRIMARY KEY,    NAME VARCHAR2(100) NOT NULL);-- 2. Πίνακας CATEGORY (Σύμφωνα με το σχήμα: CATEGORY ID, CNAME)CREATE TABLE CATEGORY (    CATEGORY_ID NUMBER PRIMARY KEY,    CNAME VARCHAR2(100) NOT NULL);-- 3. Πίνακας INGREDIENT (Σύμφωνα με το σχήμα: INGREDIENT ID, INAME, DESCRIPTION)CREATE TABLE INGREDIENT (    INGREDIENT_ID NUMBER PRIMARY KEY,    INAME VARCHAR2(100) NOT NULL,    DESCRIPTION VARCHAR2(1000));-- 4. Πίνακας USER (Σύμφωνα με το σχήμα: EMAIL, NAME, LNAME, FAVORITE)-- Σημείωση: Χρησιμοποιούμε APP_USER λόγω Oracle Reserved WordCREATE TABLE APP_USER (    EMAIL VARCHAR2(150) PRIMARY KEY,    NAME VARCHAR2(100) NOT NULL,    LNAME VARCHAR2(100) NOT NULL,    FAVORITE VARCHAR2(2000));-- 5. Πίνακας RECIPE (Σύμφωνα με το σχήμα: RECIPE ID, RNAME, INSTRUCTION, IMAGE URL, VIDEO URL, SOURCE URL, CATEGORY ID, COUNTRY ID)CREATE TABLE RECIPE (    RECIPE_ID NUMBER PRIMARY KEY,    RNAME VARCHAR2(255) NOT NULL,    INSTRUCTION VARCHAR2(3000) NOT NULL,    IMAGE_URL VARCHAR2(200),    VIDEO_URL VARCHAR2(200),    SOURCE_URL VARCHAR2(200),    CATEGORY_ID NUMBER,    COUNTRY_ID NUMBER,    CONSTRAINT FK_RECIPE_CATEGORY FOREIGN KEY (CATEGORY_ID) REFERENCES CATEGORY(CATEGORY_ID),    CONSTRAINT FK_RECIPE_COUNTRY FOREIGN KEY (COUNTRY_ID) REFERENCES COUNTRY(COUNTRY_ID));-- 6. Πίνακας RECIPE-INGREDIENTS (Σύμφωνα με το σχήμα: RECIPE ID, INGREDIENT ID, MEASUREMENTS)CREATE TABLE RECIPE_INGREDIENTS (    RECIPE_ID NUMBER,    INGREDIENT_ID NUMBER,    MEASUREMENTS VARCHAR2(100),    PRIMARY KEY (RECIPE_ID, INGREDIENT_ID),    CONSTRAINT FK_RI_RECIPE FOREIGN KEY (RECIPE_ID) REFERENCES RECIPE(RECIPE_ID),    CONSTRAINT FK_RI_INGREDIENT FOREIGN KEY (INGREDIENT_ID) REFERENCES INGREDIENT(INGREDIENT_ID));-- 7. Πίνακας USER'S MODIFY (Σύμφωνα με το σχήμα: UM ID, EMAIL, RECIPE ID, INGREDIENT ID, MODIFICATION)-- Σημείωση: Το όνομα πίνακα USERS_MODIFY (χωρίς απόστροφο για SQL compliance)CREATE TABLE USERS_MODIFY (    UM_ID NUMBER PRIMARY KEY,    EMAIL VARCHAR2(150),    RECIPE_ID NUMBER,    INGREDIENT_ID NUMBER,    MODIFICATION VARCHAR2(2000) NOT NULL,    CONSTRAINT FK_UM_USER FOREIGN KEY (EMAIL) REFERENCES APP_USER(EMAIL),    CONSTRAINT FK_UM_RECIPE FOREIGN KEY (RECIPE_ID) REFERENCES RECIPE(RECIPE_ID),    CONSTRAINT FK_UM_INGREDIENT FOREIGN KEY (INGREDIENT_ID) REFERENCES INGREDIENT(INGREDIENT_ID));